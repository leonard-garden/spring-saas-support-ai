<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        JSON structured logging for all profiles.
        Each log line is a JSON object containing:
          - level, logger, thread, timestamp
          - requestId  (set by RequestIdFilter for every request)
          - tenantId   (set by RequestIdFilter after JWT validation)
          - userId     (set by RequestIdFilter after JWT validation)
          - message
          - stack_trace (only on errors)
    -->
    <springProfile name="!dev">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeContext>false</includeContext>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <message>message</message>
                    <logger>logger</logger>
                    <thread>thread</thread>
                    <level>level</level>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

    <!-- Human-readable console output for local development -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [reqId=%X{requestId} tenant=%X{tenantId} user=%X{userId}] - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
