# =============================================================================
# Application
# =============================================================================
PORT=8081

# =============================================================================
# Database (prod only — dev uses docker-compose postgres)
# =============================================================================
DATABASE_URL=jdbc:postgresql://<host>:5432/supportsaas
DATABASE_USERNAME=supportsaas
DATABASE_PASSWORD=change-me

# =============================================================================
# JWT
# =============================================================================
# Generate: openssl rand -base64 64
JWT_SECRET=change-me

# =============================================================================
# OpenAI
# =============================================================================
OPENAI_API_KEY=sk-...

# =============================================================================
# Storage — MinIO (dev) or Cloudflare R2 (prod)
# =============================================================================
# Dev (docker-compose): leave defaults
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=support-ai-kb

# Prod — Cloudflare R2 (S3-compatible):
#   MINIO_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   MINIO_ACCESS_KEY=<R2 Access Key ID>
#   MINIO_SECRET_KEY=<R2 Secret Access Key>
#   MINIO_BUCKET=support-ai-kb

# =============================================================================
# Mail (prod only — dev uses mailhog on localhost:1025)
# =============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
# Optional: defaults to MAIL_USERNAME
MAIL_SENDER=your-email@gmail.com

# =============================================================================
# App URLs (prod only)
# =============================================================================
APP_BASE_URL=https://your-app.onrender.com
# Optional: defaults to APP_BASE_URL
CORS_ALLOWED_ORIGINS=https://your-frontend.com
