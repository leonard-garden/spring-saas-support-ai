{
  "version": "1.0",
  "tier": "full",
  "stack": {
    "language": "Java 21",
    "framework": "Spring Boot 3.3.5",
    "build_tool": "Maven",
    "test_framework": "JUnit 5 + Testcontainers",
    "package_manager": "mvn",
    "ai_framework": "Spring AI 1.0.0",
    "detected_tools": ["docker-compose", "gitleaks"]
  },
  "project": {
    "name": "spring-saas-support-ai",
    "type": "api",
    "team_size": 1,
    "stage": "active"
  },
  "architecture": {
    "style": "monolith",
    "key_layers": [
      { "name": "Auth", "dir": "src/main/java/com/leonardtrinh/supportsaas/auth/", "responsibility": "JWT, signup, login, refresh, password reset, email verification" },
      { "name": "Tenant", "dir": "src/main/java/com/leonardtrinh/supportsaas/tenant/", "responsibility": "TenantContext (ThreadLocal), Hibernate filter, Business entity" },
      { "name": "Document", "dir": "src/main/java/com/leonardtrinh/supportsaas/document/", "responsibility": "Upload API, processing orchestration, retry, ingestion pipeline, hybrid search" },
      { "name": "KnowledgeBase", "dir": "src/main/java/com/leonardtrinh/supportsaas/knowledgebase/", "responsibility": "KB CRUD" },
      { "name": "Common", "dir": "src/main/java/com/leonardtrinh/supportsaas/common/", "responsibility": "ApiResponse<T>, TenantEntity, GlobalExceptionHandler, AppException" },
      { "name": "Config", "dir": "src/main/java/com/leonardtrinh/supportsaas/config/", "responsibility": "SecurityConfig, AsyncConfig, OpenApiConfig, RequestIdFilter" }
    ],
    "entry_points": ["src/main/java/com/leonardtrinh/supportsaas/SupportSaasApplication.java"],
    "external_deps": [
      { "service": "PostgreSQL 16 + pgvector", "purpose": "Primary DB + vector store", "env_var": "SPRING_DATASOURCE_URL" },
      { "service": "MinIO", "purpose": "Object storage for uploaded documents", "env_var": "MINIO_ENDPOINT" },
      { "service": "MailHog (dev) / SMTP (prod)", "purpose": "Email sending", "env_var": "SPRING_MAIL_HOST" },
      { "service": "Anthropic Claude", "purpose": "LLM for chat responses", "env_var": "SPRING_AI_ANTHROPIC_API_KEY" },
      { "service": "OpenAI", "purpose": "Embeddings only (text-embedding-3-small)", "env_var": "SPRING_AI_OPENAI_API_KEY" }
    ],
    "gotchas": [
      "target/ — generated by mvn compile, never edit manually",
      "VectorStorage.sanitize() must strip null bytes (\\x00) and C0 controls before embedding — PostgreSQL rejects \\x00 entirely",
      "processAsync() runs in REQUIRES_NEW transaction; markFailed() must also use REQUIRES_NEW via TransactionTemplate",
      "@Async must always be @Async(\"processingExecutor\") — bare @Async breaks tenant context propagation",
      "spring.threads.virtual.enabled=false — virtual threads break ThreadLocal-based TenantContext",
      "TenantContext.clear() MUST be in a finally block in JwtAuthFilter — never skip it"
    ],
    "build_order": ["mvn clean package builds everything; no codegen step"],
    "test_isolation": ["requires Docker Compose running (postgres + minio)", "Testcontainers spins up pgvector/pgvector:pg16 automatically for IT tests"],
    "sensitive_areas": ["tenant/ — row-level isolation, correctness critical", "auth/ — JWT + SecurityConfig", "document/ingestion/ — RAG pipeline, vector operations", "billing/ — Stripe stubs (SSO planned)", "SSO integration (planned)"]
  },
  "conventions": {
    "formatter": "spotless (planned — not yet in pom.xml)",
    "branch_strategy": "gitflow",
    "commit_format": "conventional",
    "coverage_target": "80% LOC, 100% service layer + tenant isolation paths"
  },
  "permissions": {
    "preset": "java-maven",
    "disallowed_tools": [],
    "readonly_paths": ["target/"]
  },
  "hooks_selected": ["gitleaks-pre-commit", "gitleaks-pre-push"],
  "mcp_selected": ["postgres"],
  "agents_selected": ["drift-monitor", "springboot-reviewer", "tenant-guard", "api-doc-sync"],
  "ssot": {
    "adr": true,
    "codemaps": true
  },
  "collected_at": "2026-05-28T00:00:00Z"
}
